{
  "name": "portfolio-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host",
    "serve": "npm run build && vite preview --host --port 4173 --strictPort",
    "deploy": "gh-pages -d dist",
    "test": "playwright test",
    "test:functional": "playwright test tests/functional",
    "test:visual": "playwright test tests/visual",
    "test:update-snapshots": "playwright test tests/visual --update-snapshots",
    "test:report": "playwright show-report",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "gh-pages": "^6.3.0",
    "vite": "^7.0.4"
  }
}
