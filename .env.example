# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Gemini API key used by the AI chatbot (read at build/runtime, never hardcoded in source)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Web3Forms access key used by the contact form
VITE_WEB3FORMS_KEY=your-web3forms-access-key-here
# Claude Code OAuth token used by the GitHub Action for code review
CLAUDE_CODE_OAUTH_TOKEN=<your-claude-code-oauth-token-here>
